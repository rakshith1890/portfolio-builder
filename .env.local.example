# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never prefix with NEXT_PUBLIC_. Required for the admin
# dashboard (/admin): it bypasses Row Level Security to list every user and
# edit any profile. Find it in Project Settings → API → service_role key.
# Keep this out of version control and never send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
